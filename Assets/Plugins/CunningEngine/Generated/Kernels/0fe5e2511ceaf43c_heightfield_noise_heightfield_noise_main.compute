StructuredBuffer<float> src_field : register(t0);
RWStructuredBuffer<float> dst_field : register(u1);

static const uint WIDTH = 500u;
static const uint HEIGHT = 500u;
static const uint STRIDE = 2u;

uint cell_index(uint x, uint y) {
    return y * WIDTH + x;
}

uint cell_base(uint index) {
    return index * STRIDE;
}

void copy_cell(uint base) {
    for (uint i = 0u; i < STRIDE; i = i + 1u) {
        dst_field[base + i] = src_field[base + i];
    }
}

float read_layer_clamped(int x, int y, uint layer_offset) {
    uint cx = (uint)clamp(x, 0, (int)WIDTH - 1);
    uint cy = (uint)clamp(y, 0, (int)HEIGHT - 1);
    return src_field[cell_base(cell_index(cx, cy)) + layer_offset];
}
