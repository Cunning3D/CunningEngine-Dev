static const float EPSILON = 0.000001;
static const float SPARSE_MIN = -2.343510000;
static const float SPARSE_MAX = 2.438430000;
static const float SPARSE_AVG = 0.496090000;
static const float SPARSE_SIGNAL_SCALE = 4.0;
static const float SPARSE_BIAS = 0.068819620;
static const float SPARSE_METABALL_RADII[4] = { 1.3, 1.5, 1.7, 1.9 };
static const float SPARSE_METABALL_COEFFICIENTS[24] = {
    -0.001316170, -0.194211990, -0.039976236, -0.120431820, -0.249929820, 0.074289580,
    -0.023915496, 0.358847230, 0.034516662, 0.281048480, 0.427783340, -0.318169980,
    0.052872095, -0.143816920, 0.118657560, -0.230152730, -0.296374620, 0.418907230,
    -0.038225770, -0.018335572, -0.115030770, 0.084053840, 0.073640436, -0.160388930
};

float fit_clamped(float value, float old_min, float old_max, float new_min, float new_max) {
    if (abs(old_max - old_min) <= EPSILON) {
        return new_min;
    }
    float t = clamp((value - old_min) / (old_max - old_min), 0.0, 1.0);
    return lerp(new_min, new_max, t);
}

float smoothstep_local(float edge0, float edge1, float value) {
    if (abs(edge1 - edge0) <= EPSILON) {
        return value >= edge1 ? 1.0 : 0.0;
    }
    float t = clamp((value - edge0) / (edge1 - edge0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

float apply_bias(float value, float bias) {
    float safe_bias = clamp(bias, 0.0001, 0.9999);
    return value / ((((1.0 / safe_bias) - 2.0) * (1.0 - value)) + 1.0);
}

float apply_gain(float value, float gain) {
    float safe_gain = clamp(gain, 0.0001, 0.9999);
    if (value < 0.5) {
        return apply_bias(value * 2.0, safe_gain) * 0.5;
    }
    return 1.0 - apply_bias(2.0 - value * 2.0, safe_gain) * 0.5;
}

float natten(float value, float k, float e) {
    float x = value * 2.0 - 1.0;
    return pow(max(0.0, 1.0 - x * x), e * 0.5) * (1.0 - k) + k;
}

uint hash_u32(int x, int y, int z, uint seed_offset) {
    uint value = seed_offset
        ^ ((uint)x * 0x8da6b343u)
        ^ ((uint)y * 0xd8163841u)
        ^ ((uint)z * 0xcb1ab31fu)
        ^ 0x9e3779b9u;
    value = value ^ (value >> 16u);
    value = value * 0x7feb352du;
    value = value ^ (value >> 15u);
    value = value * 0x846ca68bu;
    return value ^ (value >> 16u);
}

uint sparse_slot_index(int3 cell) {
    return hash_u32(cell.y, cell.z, cell.x, 0u) & 63u;
}

float sparse_feature_value(uint slot_index, uint component) {
    return SPARSE_FEATURE_VALUES[slot_index * 3u + component];
}

float sparse_signal_value(uint slot_index, uint component) {
    return SPARSE_SIGNAL_VALUES[slot_index * 6u + component];
}

float sparse_metaball_weight(float distance_sq, float radius) {
    float radius_sq = radius * radius;
    if (distance_sq >= radius_sq) {
        return 0.0;
    }
    float t = 1.0 - distance_sq / radius_sq;
    return t * t * t;
}

float cellular_sparse_basis_raw(float3 coord) {
    int3 base = (int3)floor(coord);
    float sum = SPARSE_BIAS;
    for (int dz = -2; dz <= 2; dz = dz + 1) {
        for (int dy = -2; dy <= 2; dy = dy + 1) {
            for (int dx = -2; dx <= 2; dx = dx + 1) {
                int3 cell = base + int3(dx, dy, dz);
                uint slot = sparse_slot_index(cell);
                float3 feature = float3(
                    (float)cell.x + sparse_feature_value(slot, 0u),
                    (float)cell.y + sparse_feature_value(slot, 1u),
                    (float)cell.z + sparse_feature_value(slot, 2u)
                );
                float3 delta = coord - feature;
                float distance_sq = dot(delta, delta);
                for (uint radius_index = 0u; radius_index < 4u; radius_index = radius_index + 1u) {
                    float weight = sparse_metaball_weight(distance_sq, SPARSE_METABALL_RADII[radius_index]);
                    if (weight <= 0.0) {
                        continue;
                    }
                    float signal = 0.0;
                    for (uint component = 0u; component < 6u; component = component + 1u) {
                        signal = signal + sparse_signal_value(slot, component)
                            * SPARSE_METABALL_COEFFICIENTS[radius_index * 6u + component];
                    }
                    sum = sum + signal * weight * SPARSE_SIGNAL_SCALE;
                }
            }
        }
    }
    return sum;
}

float normalized_sparse_basis_value(float3 coord) {
    return fit_clamped(cellular_sparse_basis_raw(coord * 1.2), SPARSE_MIN, SPARSE_MAX, 0.0, 1.0);
}

float basis_pivot() {
    float pivot = SPARSE_AVG;
    if (FOLD_SIGNAL) {
        pivot = pivot * pivot;
    }
    return pivot;
}

float basis_correction(float value) {
    float out_value = value;
    if (FOLD_SIGNAL) {
        out_value = abs(out_value - SPARSE_AVG) / max(SPARSE_AVG, 1.0 - SPARSE_AVG);
    }
    return clamp(out_value, 0.0, 1.0);
}

float evaluate_basis(float3 coord) {
    return basis_correction(normalized_sparse_basis_value(coord));
}

float fractal_noise(float3 coord) {
    float base = evaluate_basis(coord);
    if (FRACTAL_TYPE == 0 || LACUNARITY * (float)OCTAVES * ROUGHNESS <= EPSILON) {
        return base;
    }

    float pivot = basis_pivot();
    float lac = abs(LACUNARITY);
    float gain = abs(ROUGHNESS) * min(lac, 1.0);
    float wk = lerp(10.0, FOLD_SIGNAL ? 10.0 : 1.6, smoothstep_local(1.0, 1.8, lac));
    float out_value = base - pivot;
    float wsum = 1.0;
    float weight = 1.0;
    if (FRACTAL_TYPE == 2) {
        weight = base;
    }
    if (FRACTAL_TYPE == 3) {
        weight = base * 2.0;
    }
    float3 octave_coord = coord;
    for (uint octave = 1u; octave <= OCTAVES; octave = octave + 1u) {
        weight = weight * gain;
        octave_coord = octave_coord * lac;
        float chaos = evaluate_basis(octave_coord) - pivot;
        out_value = out_value + weight * chaos;
        wsum = wsum + wk * weight * weight;
        if (FRACTAL_TYPE == 3) {
            weight = weight * 2.0 * (chaos + pivot);
        }
    }
    if (wsum > EPSILON) {
        out_value = out_value / sqrt(wsum);
    }
    out_value = out_value * fit_clamped(gain, 0.0, 0.1, 1.0, natten(out_value + pivot, 0.9, 2.0)) + pivot;
    return clamp(out_value, 0.0, 1.0);
}

float apply_output_correction(float chaos) {
    float out_value = chaos;
    if (USE_BIAS) {
        out_value = apply_bias(out_value, BIAS);
    }
    if (USE_GAIN) {
        out_value = apply_gain(out_value, GAIN);
    }
    if (COMPLEMENT_SIGNAL) {
        out_value = 1.0 - out_value;
    }
    out_value = clamp(out_value, min(CLIP_MIN, CLIP_MAX), max(CLIP_MIN, CLIP_MAX));
    if (CENTER_NOISE) {
        out_value = out_value - 0.5;
    }
    return out_value * AMPLITUDE;
}

float combine_height(float current, float candidate) {
    if (COMBINE_MODE == 0) {
        return candidate;
    }
    if (COMBINE_MODE == 2) {
        return current - candidate;
    }
    if (COMBINE_MODE == 3) {
        return abs(current - candidate);
    }
    if (COMBINE_MODE == 4) {
        return current * candidate;
    }
    if (COMBINE_MODE == 5) {
        return max(current, candidate);
    }
    if (COMBINE_MODE == 6) {
        return min(current, candidate);
    }
    if (COMBINE_MODE == 7) {
        return lerp(current, candidate, BLEND);
    }
    return current + candidate;
}

float3 sample_position(uint3 gid) {
    return ORIGIN
        + STEP_X * ((float)gid.x + SAMPLE_OFFSET)
        + STEP_Y * ((float)gid.y + SAMPLE_OFFSET)
        + STEP_Z * 0.5;
}

float3 transformed_noise_coord(float3 position) {
    return position * FREQUENCY - NOISE_OFFSET;
}

[numthreads(16, 16, 1)]
void heightfield_noise_main(uint3 gid : SV_DispatchThreadID) {
    if (gid.x >= WIDTH || gid.y >= HEIGHT) {
        return;
    }
    uint index = cell_index(gid.x, gid.y);
    uint base = cell_base(index);
    copy_cell(base);
    float candidate = apply_output_correction(fractal_noise(transformed_noise_coord(sample_position(gid))));
    float current = src_field[base + TARGET_OFFSET];
    dst_field[base + TARGET_OFFSET] = combine_height(current, candidate);
}
